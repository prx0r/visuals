import json, re, os, subprocess, time
from urllib.request import Request, urlopen
from urllib.parse import quote

TOKEN = open("/root/blueteam/defend/reports/token.txt").read().strip()
H = {"Authorization": f"token {TOKEN}", "User-Agent": "scanner/1.0"}
SCAN_DIR = "/tmp/opencode/terraform-scan"

# Repos known to have terraform state
repos = [
    "duduribeiro/terraform_ecs_fargate_example",
    "arulmanoharan/node-gcp",
    "h2oai/sparkling-water",
    "oxidecomputer/rfd-site",
    "mojaloop/documentation",
    "BlessedRebuS/Krawl",
    "khaledhawil/ITI-Project",
]

print("DETAILED TERRAFORM STATE ANALYSIS")
print("="*60)

for repo in repos:
    # Search for tfstate files in the repo
    data = json.loads(urlopen(Request(
        f"https://api.github.com/search/code?q=filename:terraform.tfstate+repo:{repo}",
        headers={**H, "Accept": "application/vnd.github.v3+json"}
    ), timeout=15).read())
    
    items = data.get("items", [])
    if not items:
        continue
    
    print(f"\n{repo}:")
    for item in items[:3]:
        path = item["path"]
        content = urlopen(Request(
            f"https://raw.githubusercontent.com/{repo}/HEAD/{path}",
            headers={"User-Agent": "scanner/1.0"}
        ), timeout=10).read().decode("utf-8", errors="replace")
        
        if not content:
            continue
        
        # Detailed analysis
        print(f"  File: {path}")
        print(f"  Size: {len(content)} bytes")
        
        # Check for real secrets
        findings = []
        for pattern in ["password", "secret", "private_key", "access_key", "token", "connection_string"]:
            matches = re.findall(f'"{pattern}":\\s*"([^"]+)"', content)
            for m in matches:
                if m and len(m) > 5:
                    is_real = not any(x in m.lower() for x in ["changeme", "example", "placeholder", "xxx", "test", "dummy"])
                    findings.append({
                        "type": pattern,
                        "value": m[:40],
                        "real": is_real
                    })
        
        if findings:
            print(f"  Secrets found: {len(findings)}")
            for f in findings:
                status = "🔴 REAL" if f["real"] else "⚪ TEST"
                print(f"    {status}: {f['type']} = {f['value']}...")
        else:
            print(f"  No secrets found (state may be encrypted or empty)")
    
    time.sleep(3)
