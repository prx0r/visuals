        '[id*="pricing"],' +
        '[class*="plan"],' +
        '[class*="rate-limit"]'
      ).toArray()
    ];

    const relevantText = candidates
      .map(el => $(el).text())
      .join("\n")
      .replace(/\s+/g, " ")
      .trim();

    return {
      relevantText,
      sections: []
    };
  }
}
