# 3. Generic SerpApi transport

Keep engine-specific parsing out of transport.

```ts id="ks76op"
type SerpParams = Record<
  string,
  string | number | boolean | undefined
>;

export class SerpApiClient {
  constructor(
    private readonly apiKey: string,
    private readonly baseUrl = "https://serpapi.com"
  ) {}

  async json<T>(
    params: SerpParams,
    options: {
      timeoutMs?: number;
    } = {}
  ): Promise<T> {
    const url = new URL("/search.json", this.baseUrl);

    url.searchParams.set("api_key", this.apiKey);

    for (const [key, value] of Object.entries(params)) {
      if (value !== undefined) {
        url.searchParams.set(key, String(value));
      }
    }

    if (
      params.no_cache === true &&
      params.async === true
    ) {
      throw new Error(
        "SerpApi does not allow async=true with no_cache=true"
      );
    }

    const controller = new AbortController();
    const timeout = setTimeout(
      () => controller.abort(),
      options.timeoutMs ?? 15_000
    );

    try {
      const res = await fetch(url, {
        signal: controller.signal,
        headers: {
          accept: "application/json",
          "user-agent": "LiveLLM/1.0"
        }
      });

      if (!res.ok) {
        throw new Error(`SerpApi HTTP ${res.status}`);
      }

      const body = await res.json();

      if (
        typeof body === "object" &&
        body &&
        "error" in body
      ) {
        throw new Error(String(body.error));
      }

      return body as T;
    } finally {
      clearTimeout(timeout);
    }
  }

  async markdown(
    params: SerpParams,
    options: {
      timeoutMs?: number;
    } = {}
  ): Promise<string> {
    const url = new URL("/search.md", this.baseUrl);

    url.searchParams.set("api_key", this.apiKey);

    for (const [key, value] of Object.entries(params)) {
      if (value !== undefined) {
        url.searchParams.set(key, String(value));
      }
    }

    const res = await fetch(url, {
      signal: AbortSignal.timeout(options.timeoutMs ?? 15_000),
      headers: {
        accept: "text/markdown"
      }
    });

    if (!res.ok) {
      throw new Error(`SerpApi HTTP ${res.status}`);
    }

    return res.text();
  }
}
```

This fixes an immediate flaw in current `livellm`: your adapter always calls `res.json()`, so letting callers pass `output=md` would break it.

SerpApi supports Markdown on its APIs through `/search.md`, `output=md`, or the Markdown `Accept` header. It is specifically optimized for LLM/agent consumption. ([SerpApi][1])

