# 25. Core radar orchestration

The actual function should look roughly like:

```ts id="jfin73"
export async function runRadar(ctx: Context) {
  const account =
    await ctx.account.get();

  const budget = allowedSearches(
    account,
    ctx.config.dailySearchBudget,
    ctx.config.reserve
  );

  if (budget === 0) {
    return { status: "quota_guard" };
  }

  const dueQueries =
    await ctx.scheduler.select(budget);

  const runResults = [];

  for (const query of dueQueries) {
    const search =
      await ctx.discovery.run(query);

    const results =
      await ctx.discovery.persist(search);

    const candidates =
      await ctx.candidates.fromSearchResults(results);

    for (const candidate of candidates) {
      const investigation =
        await ctx.investigator.investigate(candidate);

      if (!investigation.officialSource) {
        continue;
      }

      const observation =
        await ctx.sources.observe(
          investigation.officialSource
        );

      if (!observation.materiallyChanged) {
        continue;
      }

      const proposals =
        await ctx.ai.extractFacts(observation);

      const validated =
        await ctx.factValidator.validate(
          proposals,
          observation
        );

      const changes =
        await ctx.facts.apply(validated);

      await ctx.derivations.recompute(changes);
    }

    runResults.push(search);
  }

  return runResults;
}
```

This vertical slice matters more than adding another API.

