Governor:

```ts id="yvbd71"
export function allowedSearches(
  account: z.infer<typeof AccountSchema>,
  desired: number,
  reserve = 20
) {
  const remaining = Math.max(
    0,
    account.total_searches_left - reserve
  );

  if (remaining === 0) return 0;
  if (account.total_searches_left <= 50)
    return Math.min(1, desired, remaining);

  if (account.total_searches_left <= 100)
    return Math.min(2, desired, remaining);

  return Math.min(desired, remaining);
}
