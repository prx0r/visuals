# 20. MainNet x402 gateway skeleton

The architecture should look roughly like this:

```ts
import { Hono } from "hono";
import { serve } from "@hono/node-server";

import {
  paymentMiddleware,
  x402ResourceServer,
} from "@x402/hono";

import {
  HTTPFacilitatorClient,
} from "@x402/core/server";

import {
  ExactAvmScheme,
} from "@x402/avm/exact/server";

import {
  ALGORAND_MAINNET_CAIP2,
  USDC_MAINNET_ASA_ID,
} from "@x402/avm";

import {
  declareDiscoveryExtension,
  bazaarResourceServerExtension,
} from "@x402-avm/extensions";

const facilitator = new HTTPFacilitatorClient({
  url: process.env.FACILITATOR_URL!,
});

const resourceServer =
  new x402ResourceServer(facilitator);

resourceServer.register(
  ALGORAND_MAINNET_CAIP2,
  new ExactAvmScheme(),
);

resourceServer.registerExtension(
  bazaarResourceServerExtension as any,
);

const paid = (
  price: string,
  description: string,
  example: unknown,
) => ({
  accepts: [{
    scheme: "exact",
    price,
    network: ALGORAND_MAINNET_CAIP2,
    payTo: process.env.AVM_ADDRESS!,
    extra: {
      asset: USDC_MAINNET_ASA_ID,
      tag: "x402-global-challenge",
    },
  }],
  description,
  mimeType: "application/json",
  extensions: declareDiscoveryExtension({
    output: { example },
  }),
});

const routes = {
  "GET /v1/pulse": paid(
    "$0.001",
    "Current machine-work market snapshot",
    { open_opportunities: 1200 },
  ),

  "GET /v1/delta": paid(
    "$0.002",
    "Machine-work market changes since a supplied cursor",
    { cursor: "evt_x", changes: [] },
  ),

  "GET /v1/news": paid(
    "$0.003",
    "Actionable machine-work market news and economic signals",
    { events: [] },
  ),

  "POST /v1/rank": paid(
    "$0.02",
    "Rank open opportunities for a supplied autonomous worker profile",
    { ranked: [] },
  ),
};

const app = new Hono();

app.use(
  paymentMiddleware(routes, resourceServer),
);

app.get("/v1/pulse", async c =>
  c.json(await oracle.pulse())
);

app.get("/v1/delta", async c =>
  c.json(await oracle.delta(c.req.query("cursor")))
);

app.get("/v1/news", async c =>
  c.json(await oracle.news())
);

app.post("/v1/rank", async c =>
  c.json(await oracle.rank(await c.req.json()))
);

serve({
  fetch: app.fetch,
  port: 4021,
});
```

This follows the current official resource-server pattern, switched to MainNet and expanded into a Composite product. ([Algorand Developer Portal][13])

